<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />
        <variable name="modelo" type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
        <variable name="controlador" type="es.davante.edadcanina.controlador.EdadCaninaControlador" />
    </data>

    <!-- El contenido se puede desplazar al girar el móvil para mantener accesibles los botones -->
    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/txt_titulo"
                android:textSize="32sp" />

            <ImageView
                android:layout_width="192dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/imgdog" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/input_age"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/age_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:gravity="center"
                android:hint="@string/hint_edad"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:text="@={modelo.edadTexto}"
                android:textSize="48sp"
                app:errorValidacion="@{modelo.validacion}" />

            <!-- INVISIBLE reserva el hueco para que los botones no salten al editar -->
            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
                android:textSize="16sp"
                android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}" />

            <!-- Son acciones de la calculadora, no la barra de botones de un diálogo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="horizontal"
                tools:ignore="ButtonStyle">

                <Button
                    android:id="@+id/btn_calc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{() -> controlador.onCalcularClick()}"
                    android:text="@string/btn_calc"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_limpiar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:onClick="@{() -> controlador.onLimpiarClick()}"
                    android:text="@string/btn_limpiar"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
